# ─────────────────────────────────────────────────────────────
# DATA SOURCE
# "mock"    → run with realistic dummy data, no Shopify needed.
# "shopify" → fetch real products/collections/cart from Shopify.
# ─────────────────────────────────────────────────────────────
DATA_SOURCE=mock

# ─────────────────────────────────────────────────────────────
# SHOPIFY (only required when DATA_SOURCE=shopify)
# See SHOPIFY_SETUP.md for how to obtain each of these.
# ─────────────────────────────────────────────────────────────

# Your store's *.myshopify.com domain (no protocol, no trailing slash).
SHOPIFY_STORE_DOMAIN=

# Storefront API public access token from the Headless channel.
# Safe for server-side use in this project's architecture.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Storefront API private/delegate access token (server-to-server only).
# Preferred over the public token when both are set. NEVER expose this
# to the browser — it is only ever read in server-only modules.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Storefront API version, e.g. 2026-07. Shopify ships a new version
# quarterly — bump this rather than hardcoding a version elsewhere.
SHOPIFY_API_VERSION=2026-07

# Webhook signing secret from Shopify Admin → Settings → Notifications →
# Webhooks. Lets /api/webhooks/shopify verify a request genuinely came from
# Shopify before trusting it to refresh cached product/collection data.
SHOPIFY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VELORA
NEXT_PUBLIC_SITE_TAGLINE=Designed for everyday motion.
NEXT_PUBLIC_SITE_DESCRIPTION=A considered collection of footwear and apparel designed for everyday movement.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SHIPPING_SUMMARY=
NEXT_PUBLIC_RETURNS_SUMMARY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_SHIPPING_POLICY_URL=
NEXT_PUBLIC_RETURNS_POLICY_URL=
NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE=
NEXT_PUBLIC_NEWSLETTER_SIGNUP_URL=

# ─────────────────────────────────────────────────────────────
# ANALYTICS (optional — leave blank to disable)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
