{{ 'af-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="af-scope color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="af-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="af-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="af-features-grid">
      {%- for block in section.blocks -%}
        <div
          class="af-feature{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
          style="--animation-order: {{ forloop.index }};"
          {{ block.shopify_attributes }}
        >
          <span class="af-feature__index">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
          <h3 class="af-feature__title">{{ block.settings.title | escape }}</h3>
          <p class="af-feature__description">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AF Features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Highlights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why you'll love it"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium materials"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Every component is selected for durability and feel, not just appearance."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "AF Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Premium materials", "description": "Every component is selected for durability and feel, not just appearance." } },
        { "type": "feature", "settings": { "title": "Designed for everyday use", "description": "Built to perform under real, daily conditions — not just in a showroom." } },
        { "type": "feature", "settings": { "title": "Lightweight construction", "description": "Engineered to reduce unnecessary bulk without compromising strength." } },
        { "type": "feature", "settings": { "title": "Built for long-lasting comfort", "description": "Refined over multiple iterations so it still feels right after months of use." } }
      ]
    }
  ]
}
{% endschema %}
