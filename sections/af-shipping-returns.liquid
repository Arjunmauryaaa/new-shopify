{{ 'af-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="af-scope color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="af-heading af-heading--center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="af-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="af-icon-row af-icon-row--center list-unstyled{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      style="--af-icon-row-count: {{ section.blocks.size }};"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- for block in section.blocks -%}
        <li class="af-icon-item" style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
          {%- render 'icon-accordion', icon: block.settings.icon -%}
          <p class="af-icon-item__title">{{ block.settings.title | escape }}</p>
          <div class="af-icon-item__description rte">{{ block.settings.description }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "AF Shipping & returns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to Know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping & Returns"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-2",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "box", "label": "Box" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Free shipping on qualifying orders.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "AF Shipping & returns",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Shipping", "description": "<p>Free shipping on qualifying orders.</p>" } },
        { "type": "item", "settings": { "icon": "return", "title": "Returns", "description": "<p>Easy returns within the applicable return period.</p>" } },
        { "type": "item", "settings": { "icon": "map_pin", "title": "Tracking", "description": "<p>Receive tracking information after your order ships.</p>" } }
      ]
    }
  ]
}
{% endschema %}
