{{ 'af-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="af-scope color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="af-heading af-heading--center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="af-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    </div>

    <dl
      class="af-spec-list{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- for block in section.blocks -%}
        <div class="af-spec-row" style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label | escape }}</dt>
          <dd>{{ block.settings.value | escape }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</div>

{% schema %}
{
  "name": "AF Specifications",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Details"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Premium synthetic"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "AF Specifications",
      "blocks": [
        { "type": "spec", "settings": { "label": "Material", "value": "Premium synthetic" } },
        { "type": "spec", "settings": { "label": "Weight", "value": "280g" } },
        { "type": "spec", "settings": { "label": "Warranty", "value": "1 year" } },
        { "type": "spec", "settings": { "label": "Origin", "value": "Imported" } }
      ]
    }
  ]
}
{% endschema %}
