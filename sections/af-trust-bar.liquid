{{ 'af-theme.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div data-af-hero-anchor aria-hidden="true"></div>
<div class="af-scope color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <ul
      class="af-icon-row af-icon-row--center list-unstyled{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      style="--af-icon-row-count: {{ section.blocks.size }};"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      {%- for block in section.blocks -%}
        <li class="af-icon-item" style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
          {%- render 'icon-accordion', icon: block.settings.icon -%}
          <p class="af-icon-item__title">{{ block.settings.title | escape }}</p>
          <p class="af-icon-item__description">{{ block.settings.description | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "AF Trust bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-2",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "return", "label": "Return" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "box", "label": "Box" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "plane", "label": "Plane" },
            { "value": "question_mark", "label": "Question mark" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Fast delivery"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "AF Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free shipping", "description": "Fast delivery" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "description": "Protected payment" } },
        { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "description": "Simple returns" } },
        { "type": "item", "settings": { "icon": "chat_bubble", "title": "Customer support", "description": "We're here to help" } }
      ]
    }
  ]
}
{% endschema %}
