{%- comment -%}
  Renders a row of 5 stars, filled up to `rating` (0-5, rounded to whole stars).
  Accepts:
  - rating: {Number}
{%- endcomment -%}
{%- assign af_filled_stars = rating | round -%}
<span class="af-rating-stars" role="img" aria-label="Rated {{ rating }} out of 5 stars">
  {%- for af_i in (1..5) -%}
    <span class="af-star{% if af_i > af_filled_stars %} af-star--muted{% endif %}" aria-hidden="true">
      {{- 'icon-star.svg' | inline_asset_content -}}
    </span>
  {%- endfor -%}
</span>
