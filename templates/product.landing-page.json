        "icon_with_text": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Free shipping",
            "icon_2": "lock",
            "heading_2": "Secure checkout",
            "icon_3": "return",
            "heading_3": "Easy returns"
          }
