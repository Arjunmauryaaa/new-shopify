{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "rating": {
          "type": "rating"
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false,
            "show_add_to_cart": false
          }
        },
        "icon_with_text": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Product details",
            "icon_2": "lock",
            "heading_2": "Secure checkout",
            "icon_3": "return",
            "heading_3": "Shipping options"
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "vendor",
        "rating",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "icon_with_text",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-7",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 0,
        "padding_bottom": 36
      }
    },
    "af-trust-bar": {
      "type": "af-trust-bar",
      "blocks": {
        "item-1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Clear product details",
            "description": "Review ingredients, size, and directions"
          }
        },
        "item-2": {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Secure checkout",
            "description": "Complete your order through Shopify"
          }
        },
        "item-3": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Delivery details",
            "description": "See available shipping at checkout"
          }
        },
        "item-4": {
          "type": "item",
          "settings": {
            "icon": "chat_bubble",
            "title": "Need help?",
            "description": "Contact our team with product questions"
          }
        }
      },
      "block_order": [
        "item-1",
        "item-2",
        "item-3",
        "item-4"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "story": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Product details",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "A better fit for your routine",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Review the product description, ingredients or materials, directions, size, and care information on this page before ordering. Follow the product label and consult a qualified professional when you need personal health advice.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "caption",
        "heading",
        "text"
      ],
      "settings": {
        "image_behavior": "none",
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "af-features": {
      "type": "af-features",
      "settings": {
        "color_scheme": "scheme-1",
        "eyebrow": "Product information",
        "heading": "Know what you are choosing"
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "title": "Ingredients and materials",
            "description": "Check the product listing and label for the full ingredient or material information."
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "title": "How to use",
            "description": "Follow the directions and safety information provided with this product."
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "title": "Size and quantity",
            "description": "Review the selected size, quantity, or pack options before checkout."
          }
        },
        "feature-4": {
          "type": "feature",
          "settings": {
            "title": "Questions before you order?",
            "description": "Contact the store for help with product details, delivery, or returns."
          }
        }
      },
      "block_order": [
        "feature-1",
        "feature-2",
        "feature-3",
        "feature-4"
      ]
    },
    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "faq-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where can I find ingredients and directions?",
            "icon": "none",
            "row_content": "<p>Review the product description and packaging. Follow the product label and any applicable safety instructions.</p>"
          }
        },
        "faq-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How much does shipping cost?",
            "icon": "none",
            "row_content": "<p>Available shipping options, costs, and delivery estimates are shown at checkout for your address.</p>"
          }
        },
        "faq-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the return policy?",
            "icon": "none",
            "row_content": "<p>Please read the store refund and return policy before ordering. Product-specific restrictions, if any, are listed there.</p>"
          }
        },
        "faq-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I ask a product question?",
            "icon": "none",
            "row_content": "<p>Use the store contact page to ask about the listing before placing your order.</p>"
          }
        }
      },
      "block_order": [
        "faq-1",
        "faq-2",
        "faq-3",
        "faq-4"
      ],
      "settings": {
        "caption": "Helpful information",
        "heading": "Frequently asked questions",
        "heading_size": "h1",
        "heading_alignment": "center",
        "layout": "none",
        "container_color_scheme": "scheme-2",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "desktop_layout": "image_second",
        "image_ratio": "adapt",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "af-shipping-returns": {
      "type": "af-shipping-returns",
      "blocks": {
        "item-1": {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Shipping",
            "description": "<p>See shipping options and delivery estimates at checkout.</p>"
          }
        },
        "item-2": {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Returns",
            "description": "<p>Review the store return policy before ordering.</p>"
          }
        },
        "item-3": {
          "type": "item",
          "settings": {
            "icon": "map_pin",
            "title": "Product questions",
            "description": "<p>Contact the store if you need help with the product details.</p>"
          }
        }
      },
      "block_order": [
        "item-1",
        "item-2",
        "item-3"
      ],
      "settings": {
        "eyebrow": "Before you order",
        "heading": "Delivery and support",
        "color_scheme": "scheme-2",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "recommended": {
      "type": "related-products",
      "settings": {
        "heading": "Recommended for your routine",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 52,
        "padding_bottom": 52
      }
    }
  },
  "order": [
    "main",
    "af-trust-bar",
    "story",
    "af-features",
    "faq",
    "af-shipping-returns",
    "recommended"
  ]
}
