    "policies": {
      "type": "collapsible-content",
      "blocks": {
        "policy-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Terms & Conditions",
            "icon": "none",
            "row_content": "<p>By purchasing from this store you agree to our terms of sale, including product descriptions, pricing, and order acceptance policies. Full terms are provided at checkout and in your order confirmation.</p>"
          }
        },
        "policy-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Privacy Policy",
            "icon": "none",
            "row_content": "<p>We collect only the information required to process your order and improve your shopping experience. We do not sell your personal data.</p>"
          }
        },
        "policy-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Refund Policy",
            "icon": "none",
            "row_content": "<p>Refunds are issued to your original payment method once a qualifying return is received and inspected. Processing times vary by payment provider.</p>"
          }
        },
        "policy-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Shipping Policy",
            "icon": "none",
            "row_content": "<p>Shipping times and costs vary by destination and are calculated at checkout. Delays outside of our control may occasionally affect delivery estimates.</p>"
          }
        },
        "policy-5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Contact",
            "icon": "none",
            "row_content": "<p>Have a question before you order? Reach out through the contact details in the footer and our support team will get back to you.</p>"
          }
        }
