    "story": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Our Story",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Designed with purpose",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every detail has been designed around comfort, performance and everyday movement. Nothing here is decorative for its own sake — each choice earns its place.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": ["caption", "heading", "text"],
      "settings": {
        "image_behavior": "none",
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
