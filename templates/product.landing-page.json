    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "faq-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the shipping time?",
            "icon": "none",
            "row_content": "<p>Orders are typically processed within 1-2 business days and arrive within 3-7 business days, depending on your location.</p>"
          }
        },
        "faq-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "none",
            "row_content": "<p>We offer easy returns within the applicable return period from the delivery date, provided the item is unused and in its original packaging.</p>"
          }
        },
        "faq-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is this product covered by warranty?",
            "icon": "none",
            "row_content": "<p>Yes. This product includes a limited warranty covering manufacturing defects.</p>"
          }
        },
        "faq-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I choose the right variant?",
            "icon": "none",
            "row_content": "<p>Use the option selectors above the Add to Cart button to choose the variant that fits your needs.</p>"
          }
        }
